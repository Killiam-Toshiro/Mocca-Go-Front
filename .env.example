# Copia este archivo a .env.local para desarrollar. Todas estas variables son
# solo de servidor: ninguna llega al navegador y ninguna lleva el prefijo NEXT_PUBLIC_.

# URL base del back, con /api/v1 y sin «/» final.
# En local:   http://localhost:3000/api/v1
# En Railway: la URL de la red privada del servicio api, p. ej. http://api.railway.internal:8080/api/v1
API_URL=http://localhost:3000/api/v1

# Proxies de confianza delante de Next: 0 en local, 1 en Railway (entero de 0 a 10).
# Con 1, Next toma la IP del cliente de X-Forwarded-For y la envía al back.
TRUST_PROXY_HOPS=0

# Opcional. Fuerza el atributo Secure y el prefijo __Host- de la cookie de sesión.
# Por defecto vale true si NODE_ENV=production. Pon false solo para probar un build
# de producción en http://localhost.
# COOKIE_SECURE=false

# Opcional. Orígenes adicionales aceptados en peticiones que modifican datos (CSRF),
# separados por comas, sin ruta ni «/» final. Por defecto solo se acepta el propio host.
# ALLOWED_ORIGINS=https://app.example.com
